# Port, na którym nasłuchuje API
PORT=3000

# Połączenie z PostgreSQL (zgodne z docker-compose.yml w katalogu głównym)
DATABASE_URL="postgresql://koala:koala@localhost:5432/koala?schema=public"

# JWT – w produkcji długi, losowy sekret (np. `openssl rand -base64 48`)
JWT_SECRET="zmien-mnie-na-dlugi-losowy-sekret"
JWT_EXPIRES_IN="1h"

# Resend (https://resend.com). Bez klucza e-maile są tylko wypisywane w logach.
RESEND_API_KEY=""
MAIL_FROM="Konkurs KOALA <onboarding@resend.dev>"

# Adres strony frontendu, która odbiera link (?token=...) i wywołuje POST /api/auth/verify-email
EMAIL_VERIFICATION_URL="http://localhost:3001/weryfikacja-email"
EMAIL_VERIFICATION_TTL_HOURS=24
