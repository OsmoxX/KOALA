// Schemat bazy danych systemu KOALA.
// Dokumentacja: https://pris.ly/d/prisma-schema

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

/// Role w systemie (FR-05). Na start rejestruje się tylko nauczyciel;
/// pozostałe role nadaje administrator albo system (konta uczniów).
enum Role {
  STUDENT
  TEACHER
  JURY
  ORGANIZER
  CONTENT_EDITOR
  ADMIN

  @@map("role")
}

/// Wspólne konto logowania dla wszystkich ról.
model User {
  id                 String    @id @default(uuid()) @db.Uuid
  /// Zawsze zapisywany małymi literami, unikalny w całym systemie.
  /// Uczniowie nie mają e-maila (logują się loginem), stąd pole opcjonalne.
  email              String?   @unique
  /// Login ucznia nadawany przy zakładaniu konta (małe litery, unikalny).
  /// Nauczyciele i pozostałe role logują się e-mailem, więc u nich null.
  login              String?   @unique
  /// Skrót Argon2id, nigdy samo hasło (NFR-02).
  passwordHash       String    @map("password_hash")
  /// Hasło jednorazowe (np. nadane uczniowi przez system) – przy logowaniu
  /// trzeba je zmienić na własne, zanim reszta API będzie dostępna.
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  role               Role
  firstName          String    @map("first_name")
  lastName           String    @map("last_name")
  /// Ustawiane po kliknięciu linku weryfikacyjnego; do tego czasu konto jest nieaktywne.
  emailVerifiedAt    DateTime? @map("email_verified_at")
  /// Akceptacja regulaminu i informacji o przetwarzaniu danych (FR-07, RODO).
  termsAcceptedAt    DateTime? @map("terms_accepted_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  /// Drużyna ucznia (tylko rola STUDENT).
  teamId String? @map("team_id") @db.Uuid

  teacherProfile          TeacherProfile?
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  team                    Team?                    @relation("TeamStudents", fields: [teamId], references: [id], onDelete: SetNull)
  /// Drużyny, których użytkownik jest opiekunem (rola TEACHER).
  teamsAsTeacher          Team[]                   @relation("TeamTeacher")

  @@index([teamId])
  @@map("users")
}

/// Dane specyficzne dla nauczyciela-opiekuna (relacja 1:1 z User).
model TeacherProfile {
  userId     String @id @map("user_id") @db.Uuid
  schoolName String @map("school_name")
  schoolCity String @map("school_city")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("teacher_profiles")
}

/// Jednorazowy token z linku weryfikacyjnego. W bazie trzymamy tylko skrót SHA-256,
/// więc wyciek bazy nie pozwala aktywować cudzych kont.
model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

/// Kategoria wiekowa drużyny z limitem liczby uczniów (wg regulaminu).
/// Kategorie XIII edycji (SP kl. 6–8, szkoły ponadpodstawowe; 3–4 uczniów)
/// dodaje migracja `teams_management` (KOALA-80).
model TeamCategory {
  id         String @id @default(uuid()) @db.Uuid
  name       String @unique
  minMembers Int    @map("min_members")
  maxMembers Int    @map("max_members")

  teams Team[]

  @@map("team_categories")
}

/// Drużyna (KOALA-80): opiekun (nauczyciel) + uczniowie. Nauczyciel może
/// prowadzić wiele drużyn, uczeń należy do jednej (User.teamId).
/// Konta uczniów zakłada API drużyn (KOALA-81/82).
model Team {
  id         String   @id @default(uuid()) @db.Uuid
  /// Unikalna w obrębie nauczyciela (serwis sprawdza też bez wielkości liter).
  name       String
  categoryId String   @map("category_id") @db.Uuid
  teacherId  String   @map("teacher_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  category TeamCategory @relation(fields: [categoryId], references: [id])
  teacher  User         @relation("TeamTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  students User[]       @relation("TeamStudents")

  @@unique([teacherId, name])
  @@index([teacherId])
  @@map("teams")
}

/// Jednorazowy token resetu hasła (KOALA-86). Jak przy weryfikacji e-mail
/// trzymamy tylko skrót SHA-256 tokenu.
model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  /// Konto, którego hasło zostanie zmienione (np. uczeń – mail idzie do opiekuna).
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}
